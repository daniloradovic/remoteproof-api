APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
# APP_VERSION is set by the deploy script to the git short SHA so /api/health can report it.
APP_VERSION=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Trusted reverse-proxy hops, comma-separated CIDRs. Empty trusts only private
# ranges (safe default — covers Railway's edge->container hop). Pin a specific
# edge range here if you have one. `*` trusts every hop and lets clients spoof
# their IP past the per-IP rate limit/cap — use only as a deliberate escape hatch.
TRUSTED_PROXIES=

# CORS — comma-separated lists, no value means no cross-origin access.
# Example: EXTENSION_ORIGIN=chrome-extension://abcdef123,chrome-extension://localdev456
EXTENSION_ORIGIN=
LANDING_ORIGIN=

# Anthropic spend guards. All UTC. Cache hits do not count against any of these.
#   DAILY        — burst protection against a single bad day eating the month.
#   MONTHLY      — service-wide ceiling (target ~$40/mo at $0.0075/call).
#   PER_ANON     — per-install quota so one user can't drain everyone else.
#   PER_IP_DAILY — caps a single IP so one attacker can't burn the daily cap for everyone.
ANTHROPIC_DAILY_CAP=250
ANTHROPIC_MONTHLY_CAP=5000
PER_ANON_MONTHLY_CAP=50
PER_IP_DAILY_CAP=50

# Slack webhook for cap-trip alerts. Posts once per cap per reset window (no flood).
# Leave empty to disable; failures are swallowed and logged locally.
CAP_ALERTS_SLACK_WEBHOOK_URL=

# Sentry — leave DSN empty to disable. Traces sample rate of 0.1 keeps performance
# data useful without paying for every request. Release is auto-tagged from APP_VERSION.
SENTRY_LARAVEL_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1

# Comma-separated emails allowed into /pulse and the admin panel.
ADMIN_EMAILS=
